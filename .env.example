APP_NAME=pykata
APP_ENV=dev
LOG_LEVEL=INFO
DEBUG=True

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

LOCALSTACK_SERVICES=s3,dynamodb,lambda,apigateway
LOCALSTACK_DEBUG=1
LOCALSTACK_LAMBDA_EXECUTOR=docker
LOCALSTACK_DEFAULT_REGION=${AWS_DEFAULT_REGION}
LOCALSTACK_ENDPOINT=http://localhost:4566
LOCALSTACK_S3_ENDPOINT=http://s3.localhost.localstack.cloud:4566

TF_VAR_project_name=${APP_NAME}
TF_VAR_environment=${APP_ENV}
TF_VAR_access_key=${AWS_ACCESS_KEY_ID}
TF_VAR_secret_key=${AWS_SECRET_ACCESS_KEY}
TF_VAR_aws_region=${AWS_DEFAULT_REGION}
TF_VAR_localstack_endpoint=${LOCALSTACK_ENDPOINT}
TF_VAR_s3_localstack_endpoint=${LOCALSTACK_S3_ENDPOINT}
