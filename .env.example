# Application Settings
export APP_NAME=pykata
export APP_ENV=dev
export LOG_LEVEL=INFO
export DEBUG=True

# AWS Configuration
export AWS_ACCESS_KEY_ID=test
export AWS_SECRET_ACCESS_KEY=test
export AWS_DEFAULT_REGION=us-east-1

# LocalStack Configuration
export LOCALSTACK_SERVICES=s3,dynamodb,lambda,apigateway
export LOCALSTACK_DEBUG=1
export LOCALSTACK_LAMBDA_EXECUTOR=docker
export LOCALSTACK_DEFAULT_REGION=${AWS_DEFAULT_REGION}
export LOCALSTACK_ENDPOINT=http://localhost:4566
export LOCALSTACK_S3_ENDPOINT=http://s3.localhost.localstack.cloud:4566

# Terraform Variables
export TF_VAR_project_name=${APP_NAME}
export TF_VAR_environment=${APP_ENV}
export TF_VAR_access_key=${AWS_ACCESS_KEY_ID}
export TF_VAR_secret_key=${AWS_SECRET_ACCESS_KEY}
export TF_VAR_aws_region=${AWS_DEFAULT_REGION}
export TF_VAR_localstack_endpoint=${LOCALSTACK_ENDPOINT}
export TF_VAR_s3_localstack_endpoint=${LOCALSTACK_S3_ENDPOINT}
